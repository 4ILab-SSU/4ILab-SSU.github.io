{% assign recent_items = '' %}{% assign older_items = '' %}{% assign older_count = 0 %}
{% assign items = include.items | sort: 'date' | reverse %}
{% for p in items %}
  {% assign item_year = p.date | date: '%Y' | plus: 0 %}
  {% capture row %}
    <li>
      <span class="status-badge {{ p.country | downcase }}">{{ p.country }}</span><span class="status-badge {{ p.status }}">{{ p.status }}</span>
      <span class="item-title">{% if p.url %}<a href="{{ p.url }}">{{ p.title }}</a>{% else %}{{ p.title }}{% endif %}</span><br>
      <span class="item-meta">{{ p.inventors }} · {{ p.number }}{% if p.assignee %} · {{ p.assignee }}{% endif %} · {{ p.date | date: "%b %d, %Y" }}</span>
    </li>
  {% endcapture %}
  {% if item_year <= include.year %}
    {% assign older_items = older_items | append: row %}
    {% assign older_count = older_count | plus: 1 %}
  {% else %}
    {% assign recent_items = recent_items | append: row %}
  {% endif %}
{% endfor %}
{% if recent_items != '' %}<ul class="patent-list">{{ recent_items }}</ul>{% endif %}
{% if older_count > 0 %}
  {% capture older_content %}<ul class="patent-list">{{ older_items }}</ul>{% endcapture %}
  {% include publication-archive.liquid content=older_content count=older_count year=include.year %}
{% endif %}
